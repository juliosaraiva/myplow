#!/usr/bin/env python3
"""mp, the agent CLI. One part per verb group, executed into this file.

The implementation lives in ``../lib/agent`` and is executed into this module, in order.
Imports, monkeypatches and ``__file__`` keep seeing this path.
"""


def _load_implementation():
    import os
    here = os.path.dirname(os.path.abspath(__file__))
    base = os.path.normpath(os.path.join(here, '../lib/agent'))
    namespace = globals()
    for name in (
        "support.py",
        "spawn.py",
        "messaging.py",
        "revive.py",
        "fleet.py",
        "model.py",
        "status.py",
        "board.py",
        "cron.py",
        "tcc.py",
        "commands.py",
    ):
        path = os.path.join(base, name)
        with open(path, encoding="utf-8") as source:
            exec(compile(source.read(), path, "exec"), namespace)


_load_implementation()
del _load_implementation
